# Node.js >=24. Copy to .env; never commit credentials.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/cqa.sqlite

# Existing server integration is opt-in.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=stealth/crouton-alpha
AI_STRUCTURED_OUTPUT=json_schema
AI_TIMEOUT_MS=55000
AI_REQUEST_TIMEOUT_MS=35000
AI_MAX_TOKENS=4096
AI_DIAGNOSTIC_DIR=data/ai-diagnostics

# Optional OpenRouter provider pin. Leave unset for a two-model benchmark.
# AI_PROVIDER=stealth
# Crouton uses minimal reasoning by default; other models leave reasoning unset.
# AI_REASONING_EFFORT=minimal

# Optional signed organizer URL from the PDF; keep its actual value only in .env.
ORGANIZER_API_URL=
